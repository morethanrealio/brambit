[Unit]
Description=runnerd (sandbox HTTP)
After=docker.service brambs-sbx-fw.service
Requires=docker.service
[Service]
User=root
EnvironmentFile=/etc/brambs-runnerd.env
WorkingDirectory=/home/ec2-user/sandbox
ExecStart=/usr/bin/node /home/ec2-user/sandbox/runnerd.mjs
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
