# /etc/brambs-runnerd.env (máquina dedicada). Copie, troque o token e chmod 600.
# O mesmo token vai no .env do harness como SANDBOX_TOKEN.
RUNNER_TOKEN=troque-por-um-token-longo-e-aleatorio
RUNNERD_PORT=9000
# 0.0.0.0 porque o harness chega pela rede privada; feche a porta no firewall da
# nuvem (security group) pra aceitar só o endereço do harness.
RUNNERD_HOST=0.0.0.0
# Opcionais (os valores abaixo são o padrão):
# SANDBOX_IMAGE=brambs-sandbox:latest
# SANDBOX_NETWORK=brambs-sbx
# SANDBOX_MEM=512m
# SANDBOX_CPUS=1
# SANDBOX_PIDS=256
# SANDBOX_EXEC_TIMEOUT_MS=60000
# RUNNER_MAX_FILE=26214400
