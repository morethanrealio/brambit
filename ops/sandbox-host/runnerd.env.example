# /etc/brambs-runnerd.env (dedicated machine). Copy, change the token and chmod 600.
# The same token goes in the harness's .env as SANDBOX_TOKEN.
RUNNER_TOKEN=troque-por-um-token-longo-e-aleatorio
RUNNERD_PORT=9000
# 0.0.0.0 because the harness reaches it over the private network; close the port in
# the cloud firewall (security group) to accept only the harness's address.
RUNNERD_HOST=0.0.0.0
# Optional (the values below are the default):
# SANDBOX_IMAGE=brambs-sandbox:latest
# SANDBOX_NETWORK=brambs-sbx
# SANDBOX_MEM=512m
# SANDBOX_CPUS=1
# SANDBOX_PIDS=256
# SANDBOX_EXEC_TIMEOUT_MS=60000
# RUNNER_MAX_FILE=26214400
