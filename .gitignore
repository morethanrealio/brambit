# deps
# also without a slash: with a slash it only matches a DIRECTORY, and a symlink named
# node_modules used to slip through and land in the commit (broke prod on 2026-09-09)
node_modules
node_modules/

# secrets / runtime env (NEVER commit)
.env
.env.*
!.env.example

# media generated at runtime (goes to S3, not to the repo)
web/public/media/

# logs / temporary files
*.log
*.tmp
__pycache__/

# local index of development tools
.graymatter/

.engagement-build/

.routines-build/

.deepseek-build/
.billing-build/

.onboarding-build/

# Encrypted runtime task checkpoints (never publish)
.brambs-coding-tasks/

# Encrypted provider observations and billing recovery (never publish)
.brambs-credit-calls/

.discovery-build/

# local setup (npm run local): disposable database and stores
.local/

# local choice of providers and models (the example is modelos.example.yaml)
/modelos.yaml

# Runner executables generated by runner-go/build.sh (the cloud keeps its own in the brand folder)
web/public/runner-bin/

# deploy-prod.sh: new install side by side and the previous one kept
.npm-novo.*/
node_modules.antigo/
