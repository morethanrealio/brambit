# Configuração de exemplo do servidor (web/server.mjs).
#
# Copie para .env e preencha só o que for usar:  cp .env.example .env
# O .env nunca vai pro git (.gitignore). Nenhum valor aqui é real: segredo fica
# vazio e endereço aponta pra sua própria máquina.
#
# Como ler este arquivo:
#   VAR=valor     linha ativa, necessária pra subir na sua máquina.
#   # VAR=valor   opcional; o valor mostrado é o padrão do código (deixe comentado
#                 pra usar o padrão). Sem valor = recurso desligado até você preencher.
#
# Cada recurso opcional desliga sozinho quando falta a configuração dele
# (WhatsApp, Slack, cobrança, conectores...). O mínimo pra abrir a tela e fazer
# login é o bloco 1; pra conversar com o assistente, some uma chave de modelo (bloco 2).
#
# A checagem test-support/env-example-guard.mjs (roda no CI) garante que este arquivo
# lista toda variável que o código lê, sem IP interno nem segredo. Variável nova no
# código = linha nova aqui.

# ---------------------------------------------------------------------------
# 1. Obrigatório pra subir
# ---------------------------------------------------------------------------

# Endereço e porta do servidor HTTP.
HOST=127.0.0.1
PORT=8080

# Endereço público do app (links em e-mail, mensagem e callback). Na sua máquina,
# o mesmo de HOST:PORT. Sem isso o código cai no domínio de produção.
PUBLIC_BASE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:8080

# PostgreSQL. Crie o schema antes (CREATE SCHEMA mtr_harness); o servidor cria as
# tabelas no boot. Os arquivos de migrations/ rodam à mão depois do primeiro boot.
PGHOST=localhost
PGPORT=5432
PGUSER=brambs
PGPASSWORD=
PGDATABASE=brambs

# Cofre de segredos (credenciais de conector, segredos de app). Escolha UM:
#   BRAMBS_LOCAL=1   gera uma chave sozinha em ~/.brambs/vault.key (só pra sua máquina)
#   VAULT_KEY        32 bytes em base64 (ex.: openssl rand -base64 32)
#   VAULT_KEY_ENC    chave cifrada por um KMS da AWS (produção; precisa de KMS_KEY_ID)
BRAMBS_LOCAL=1
# VAULT_KEY=
# VAULT_KEY_ENC=
# VAULT_KEY_FILE=~/.brambs/vault.key
# KMS_KEY_ID=
# KMS_REGION=sa-east-1

# ---------------------------------------------------------------------------
# 2. Modelos de linguagem (pelo menos uma chave pra conversar)
# ---------------------------------------------------------------------------

# Jeito recomendado: escolher provedor e modelo de cada função no modelos.yaml
# (cp modelos.example.yaml modelos.yaml; o arquivo explica cada campo) e colar
# aqui só as chaves que ele cita. Com modelos.yaml, as variáveis de escolha de
# modelo abaixo deixam de valer pro texto (menos os modelos que o usuário escolhe
# por assistente, no fim deste bloco); sem ele, vale o roteamento embutido.

# Modelo principal de texto (padrão: DeepSeek V4.1 Flash na Together).
# TOGETHER_API_KEY=
# TOGETHER_URL=https://api.together.xyz/v1/chat/completions
# Gemini: reserva do texto e tudo que é imagem, áudio e PDF.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_URL=https://api.openai.com/v1/chat/completions
# DEEPINFRA_API_KEY=
# DEEPINFRA_URL=https://api.deepinfra.com/v1/openai/chat/completions
# Nemotron (self-hosted, OpenAI-compatível): ligado com MODEL_PROVIDER=nemotron.
# NEMOTRON_URL=
# NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Escolha de modelo e provedor.
# MODEL_PROVIDER=gemini
# PRIMARY_TEXT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# PRIMARY_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
# FALLBACK_TEXT_MODEL=gemini-3.7-flash
# FALLBACK_MODEL=gpt-5.4-mini
# CHEAP_MODEL=deepseek-ai/DeepSeek-V4-Flash
# SEARCH_FALLBACK_MODEL=gemini-3.7-flash
# ROBUSTO_PROVIDER=together
# DEEPSEEK_PROVIDER=together
# DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
# DEEPSEEK_FLASH_ENABLED=1
# Chave da API oficial do DeepSeek (modelo escolhível DeepSeek V4.1 Flash; um plugin pode trazer a dele).
# DEEPSEEK_API_KEY=
# Modelos que o usuário escolhe por assistente (1 = aparece na lista).
# DEEPSEEK_ENABLED=
# KIMI_ENABLED=
# KIMI_MODEL=moonshotai/Kimi-K3
# KIMI_PROVIDER=together

# Jev (TypeSafe): classificador barato usado nas travas de ferramenta.
# TYPESAFE_API_KEY=
# JEV_TRAVAS=1
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# 3. Login e painel de administração
# ---------------------------------------------------------------------------

# Login com Google (também é a conexão de Gmail, Agenda e Drive).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# Login com Apple.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Quem é administrador (e-mail da conta).
# ADMIN_EMAIL=
# Painel /metrics: usuário, senha e segredo do código de 6 dígitos (TOTP).
# METRICS_USER=metrics
# METRICS_PASS=
# METRICS_TOTP_SECRET=

# ---------------------------------------------------------------------------
# 4. E-mail
# ---------------------------------------------------------------------------

# Envio de e-mail do sistema (cadastro, avisos). SMTP OU Resend.
# MAIL_FROM=
# MAIL_FROM_NAME=Assistente
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# RESEND_API_KEY=

# Caixa de entrada própria do assistente (IMAP + SMTP, ex.: Gmail com senha de app).
# EMAIL_ADDRESS=
# EMAIL_APP_PASSWORD=
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_POLL_MS=30000
# EMAIL_STRICT_AUTH=
# EMAIL_TRUSTED_AUTHSERV=mx.google.com
# EMAIL_DEBUG=

# ---------------------------------------------------------------------------
# 5. Canais de conversa
# ---------------------------------------------------------------------------

# WhatsApp Cloud API (Meta). Liga quando as quatro primeiras estão preenchidas.
# WA_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_VERIFY_TOKEN=
# WA_APP_SECRET=
# WA_BUSINESS_NUMBER=
# WA_DEBOUNCE_MS=3000
# WA_INTERJECT=1
# WA_TURN_HEARTBEAT_MS=60000

# Slack (bot de entrada).
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# Telegram: cada usuário traz o token do próprio bot; ele fica no banco, não aqui.
# TELEGRAM_TIMEOUT_MS=20000
# TELEGRAM_TURN_HEARTBEAT_MS=60000

# App de celular.
# MOBILE_APP_VERSION=0.1.6
# MOBILE_APP_BUILD=7
# MOBILE_TELEMETRY_TOKEN=

# ---------------------------------------------------------------------------
# 6. Conectores (OAuth). Cada um aparece pro usuário quando tem as três.
# ---------------------------------------------------------------------------

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=
# LINKEDIN_SCOPE=openid profile w_member_social
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=
# NUVEMSHOP_CLIENT_ID=
# NUVEMSHOP_CLIENT_SECRET=
# NUVEMSHOP_REDIRECT_URI=
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# CANVA_REDIRECT_URI=
# CANVA_SCOPE=
# CANVA_MCP_URL=https://mcp.canva.com/mcp

# ---------------------------------------------------------------------------
# 7. Busca na web
# ---------------------------------------------------------------------------

# TAVILY_API_KEY=
# TAVILY_URL=https://api.tavily.com/search
# TAVILY_EXTRACT_URL=https://api.tavily.com/extract
# SerpApi: busca por imagem e passagens aéreas.
# SERPAPI_KEY=
# MAX_SEARCHES_PER_TURN=
# FLIGHT_CACHE_MIN=180
# FONTES_LINKS=1

# ---------------------------------------------------------------------------
# 8. Arquivos e mídia (S3)
# ---------------------------------------------------------------------------

# Credencial do S3: S3_INSTANCE_ROLE=1 usa a role da instância EC2 (IMDSv2,
# sem chave no disco). Sem a flag, usa a chave fixa abaixo.
# S3_INSTANCE_ROLE=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1
# CAMPAIGN_S3_BUCKET=
# CAMPAIGN_S3_REGION=us-east-1
# Antivírus dos anexos (ClamAV). Socket local OU host+porta.
# CLAMD_SOCKET=
# CLAMD_HOST=
# CLAMD_PORT=3310

# ---------------------------------------------------------------------------
# 9. Execução de código e apps (serviços à parte; sem eles o recurso some)
# ---------------------------------------------------------------------------

# Sandbox de código (runnerd). Endereço do SEU serviço; o token é o Bearer dele.
# Na sua máquina: ops/sandbox-host/local.sh imprime as duas linhas.
# SANDBOX_URL=
# SANDBOX_TOKEN=
# Host de apps publicados pelos usuários (acesso SSH e caminho do controlador).
# APPS_HOST_SSH=
# APPS_HOST_KEY=
# Domínio dos apps (<dono>.<domínio>/<sistema>/); sem ele, o host do site da marca.
# Vai junto em cada chamada ao ctl.py, que monta o link do app com ele.
# APPS_DOMAIN=
# Onde o ops/apps-host/deploy.sh instala o ctl.py no host de apps.
# APPS_CTL_PATH=/opt/brambs-ctl/ctl.py
# Máquina de desenvolvimento do modo dev.
# DEVEXEC_URL=
# DEVEXEC_TOKEN=
# Geração de vídeo (ComfyUI).
# COMFY_URL=
# COMFY_TOKEN=
# VIDEO_EM_REVISAO=1
# Saída de rede das ferramentas: log (só registra) ou block.
# EGRESS_MODE=log
# Pastas locais de estado de tarefas (padrão: dentro do repo).
# APP_TASK_STORE_DIR=
# CODING_JOB_STORE_DIR=

# ---------------------------------------------------------------------------
# 10. Ajuste fino (o padrão do código serve; mexa só se souber o efeito)
# ---------------------------------------------------------------------------

# Memória e compactação da conversa (em tokens).
# COMPACT_HIGH=24000
# COMPACT_LOW=12000
# SUMMARY_CAP=3000
# LEDGER_CAP=6000
# MEMORIA_BUSCA_V2=
# MEMORIA_HISTORICO=
# MEMORIA_RECONCILIAR=
# PERFIL_MODO=
# PERFIL_MAX_LINHAS=15
# PERFIL_DIFF_VERBOSE=

# Sub-agente de programação.
# CODE_DEFER=1
# CODING_BLOB_MAX=
# CODING_COMPACT=
# CODING_COMPACT_TRIGGER=
# CODING_HISTORY_MAX=
# CODING_KEEP_RECENT=
# CODING_SESSION_TTL_MS=

# Conversa entre assistentes.
# A2A_BUDGET_TOKENS=40000
# A2A_MAX_ROUNDS=3
# A2A_NOTIFY_EMAIL=

# Créditos.
# CREDIT_CHECKPOINT_RETENTION_DAYS=

# Outros.
# CALENDAR_WATCH=1
# HOME_REFRESH_COOLDOWN_MS=86400000
# FREIO_FUNDAMENTACAO=1
# LIKENESS_AUTO_VERIFY=
# DISCOVERY_ENABLED=
# TURN_HEARTBEAT_MS=60000
