# Example server configuration (web/server.mjs).
#
# Copy to .env and fill in only what you'll use:  cp .env.example .env
# .env never goes into git (.gitignore). No value here is real: secrets stay
# empty and addresses point to your own machine.
#
# How to read this file:
#   VAR=value     active line, needed to run on your machine.
#   # VAR=value   optional; the shown value is the code's default (leave it commented
#                 out to use the default). No value = feature disabled until you fill it in.
#
# Each optional feature turns itself off when its configuration is missing
# (WhatsApp, Slack, billing, connectors...). The minimum to open the screen and
# log in is block 1; to chat with the assistant, add a model key (block 2).
#
# The test-support/env-example-guard.mjs check (runs in CI) ensures this file
# lists every variable the code reads, with no internal IP or secret. A new variable in
# the code = a new line here.

# ---------------------------------------------------------------------------
# 1. Required to run
# ---------------------------------------------------------------------------

# Address and port of the HTTP server.
HOST=127.0.0.1
PORT=8080

# Public address of the app (links in email, messages and callbacks). On your machine,
# the same as HOST:PORT. Without this the code falls back to the production domain.
PUBLIC_BASE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:8080

# PostgreSQL. Create the schema first (CREATE SCHEMA mtr_harness); the server creates the
# tables on boot. The files in migrations/ run by hand after the first boot.
PGHOST=localhost
PGPORT=5432
PGUSER=brambs
PGPASSWORD=
PGDATABASE=brambs

# Secrets vault (connector credentials, app secrets). Choose ONE:
#   BRAMBS_LOCAL=1   generates a key on its own at ~/.brambs/vault.key (your machine only)
#   VAULT_KEY        32 bytes in base64 (e.g.: openssl rand -base64 32)
#   VAULT_KEY_ENC    key encrypted by an AWS KMS (production; needs KMS_KEY_ID)
BRAMBS_LOCAL=1
# VAULT_KEY=
# VAULT_KEY_ENC=
# VAULT_KEY_FILE=~/.brambs/vault.key
# KMS_KEY_ID=
# KMS_REGION=sa-east-1

# ---------------------------------------------------------------------------
# 2. Language models (at least one key to chat)
# ---------------------------------------------------------------------------

# Recommended way: choose the provider and model for each function in modelos.yaml
# (cp modelos.example.yaml modelos.yaml; the file explains each field) and paste
# here only the keys it references. With modelos.yaml, the model-choice variables
# below stop applying to text (except the models the user chooses
# per assistant, at the end of this block); without it, the built-in routing applies.

# Main text model (default: DeepSeek V4.1 Flash on Together).
# TOGETHER_API_KEY=
# TOGETHER_URL=https://api.together.xyz/v1/chat/completions
# Gemini: fallback for text and everything that's image, audio and PDF.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_URL=https://api.openai.com/v1/chat/completions
# DEEPINFRA_API_KEY=
# DEEPINFRA_URL=https://api.deepinfra.com/v1/openai/chat/completions
# Nemotron (self-hosted, OpenAI-compatible): enabled with MODEL_PROVIDER=nemotron.
# NEMOTRON_URL=
# NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Model and provider choice.
# MODEL_PROVIDER=gemini
# PRIMARY_TEXT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# PRIMARY_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
# FALLBACK_TEXT_MODEL=gemini-3.7-flash
# FALLBACK_MODEL=gpt-5.4-mini
# CHEAP_MODEL=deepseek-ai/DeepSeek-V4-Flash
# SEARCH_FALLBACK_MODEL=gemini-3.7-flash
# ROBUSTO_PROVIDER=together
# DEEPSEEK_PROVIDER=together
# DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813
# DEEPSEEK_FLASH_ENABLED=1
# Official DeepSeek API key (user-selectable DeepSeek V4.1 Flash model; a plugin can bring its own).
# DEEPSEEK_API_KEY=
# Models the user chooses per assistant (1 = shows up in the list).
# DEEPSEEK_ENABLED=
# KIMI_ENABLED=
# KIMI_MODEL=moonshotai/Kimi-K3
# KIMI_PROVIDER=together

# Jev (TypeSafe): cheap classifier used in tool guards.
# TYPESAFE_API_KEY=
# JEV_TRAVAS=1
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# 3. Login and admin panel
# ---------------------------------------------------------------------------

# Login with Google (also the connection for Gmail, Calendar and Drive).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# Login with Apple.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Who is the administrator (account email).
# ADMIN_EMAIL=
# Sign-up: "closed" = only ADMIN_EMAIL creates an account freely; everyone else comes
# in with their invite code or a company invite. Empty = open to anyone.
# BRAMBIT_SIGNUP=closed

# Only for npm run brambit (on your own computer): data folder (default ~/.brambit)
# and the port on the first run (default 8080 if free; then it is saved).
# BRAMBIT_DATA_DIR=
# BRAMBIT_PORT=
# The launcher hands the server a summary of this installation (address, folder, AI),
# which the owner sees in Settings. No need to fill it in.
# BRAMBIT_INSTALLATION=
# /metrics panel: username, password and secret for the 6-digit code (TOTP).
# METRICS_USER=metrics
# METRICS_PASS=
# METRICS_TOTP_SECRET=

# ---------------------------------------------------------------------------
# 4. Email
# ---------------------------------------------------------------------------

# System email sending (signup, notices). SMTP OR Resend.
# MAIL_FROM=
# MAIL_FROM_NAME=Assistente
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# RESEND_API_KEY=

# Assistant's own inbox (IMAP + SMTP, e.g.: Gmail with an app password).
# EMAIL_ADDRESS=
# EMAIL_APP_PASSWORD=
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_POLL_MS=30000
# EMAIL_STRICT_AUTH=
# EMAIL_TRUSTED_AUTHSERV=mx.google.com
# EMAIL_DEBUG=

# ---------------------------------------------------------------------------
# 5. Conversation channels
# ---------------------------------------------------------------------------

# WhatsApp Cloud API (Meta). Turns on when the first four are filled in.
# WA_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_VERIFY_TOKEN=
# WA_APP_SECRET=
# WA_BUSINESS_NUMBER=
# WA_DEBOUNCE_MS=3000
# WA_INTERJECT=1
# WA_TURN_HEARTBEAT_MS=60000
# Public support: id of the assistant that responds to whoever writes to the
# number without an account. Empty = those people get the login message.
# The assistant's owner still needs to turn on support.
# ATENDIMENTO_PUBLICO_AGENTE=
# Chopped-up messages from whoever writes to support become a single reply: wait
# this long after the last one (ms), at most MAX since the first.
# WA_PUBLICO_JUNTAR_MS=1500
# WA_PUBLICO_JUNTAR_MAX_MS=5000
# How long (ms) a public-support outbound message with an image waits for Meta to confirm
# delivery before the next one goes out (0 = doesn't wait).
# WA_ESPERA_ENTREGA_MS=15000

# Slack (inbound bot).
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# Telegram: each user brings their own bot token; it lives in the database, not here.
# TELEGRAM_TIMEOUT_MS=20000
# TELEGRAM_TURN_HEARTBEAT_MS=60000
# Resend of the ready reply when Telegram/Slack sending fails on the network (waits in ms).
# CANAL_REENVIO_MS=2000,8000

# Mobile app.
# MOBILE_APP_VERSION=0.1.6
# MOBILE_APP_BUILD=7
# MOBILE_TELEMETRY_TOKEN=

# ---------------------------------------------------------------------------
# 6. Connectors (OAuth). Each one appears to the user when all three are set.
# ---------------------------------------------------------------------------

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=
# LINKEDIN_SCOPE=openid profile w_member_social
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=
# NUVEMSHOP_CLIENT_ID=
# NUVEMSHOP_CLIENT_SECRET=
# NUVEMSHOP_REDIRECT_URI=
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# CANVA_REDIRECT_URI=
# CANVA_SCOPE=
# CANVA_MCP_URL=https://mcp.canva.com/mcp

# ---------------------------------------------------------------------------
# 7. Web search
# ---------------------------------------------------------------------------

# TAVILY_API_KEY=
# TAVILY_URL=https://api.tavily.com/search
# TAVILY_EXTRACT_URL=https://api.tavily.com/extract
# SerpApi: image search and flights.
# SERPAPI_KEY=
# MAX_SEARCHES_PER_TURN=
# FLIGHT_CACHE_MIN=180
# FONTES_LINKS=1

# ---------------------------------------------------------------------------
# 8. Files and media (S3)
# ---------------------------------------------------------------------------

# S3 credential: S3_INSTANCE_ROLE=1 uses the EC2 instance role (IMDSv2,
# no key on disk). Without the flag, uses the fixed key below.
# S3_INSTANCE_ROLE=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1
# CAMPAIGN_S3_BUCKET=
# CAMPAIGN_S3_REGION=us-east-1
# Antivirus for attachments (ClamAV). Local socket OR host+port.
# CLAMD_SOCKET=
# CLAMD_HOST=
# CLAMD_PORT=3310

# ---------------------------------------------------------------------------
# 9. Code execution and apps (separate services; without them the feature disappears)
# ---------------------------------------------------------------------------

# Code sandbox (runnerd). Address of YOUR service; the token is its Bearer.
# On your machine: ops/sandbox-host/local.sh prints both lines.
# SANDBOX_URL=
# SANDBOX_TOKEN=
# Host for apps published by users (SSH access and controller path).
# APPS_HOST_SSH=
# APPS_HOST_KEY=
# Apps domain (<owner>.<domain>/<system>/); without it, the brand site's host.
# Sent along with every call to ctl.py, which builds the app link with it.
# APPS_DOMAIN=
# Where ops/apps-host/deploy.sh installs ctl.py on the apps host.
# APPS_CTL_PATH=/opt/brambs-ctl/ctl.py
# Development machine for dev mode.
# DEVEXEC_URL=
# DEVEXEC_TOKEN=
# Video generation (ComfyUI).
# COMFY_URL=
# COMFY_TOKEN=
# VIDEO_EM_REVISAO=1
# Network egress for tools: log (just records) or block.
# EGRESS_MODE=log
# Local task-state folders (default: inside the repo).
# APP_TASK_STORE_DIR=
# CODING_JOB_STORE_DIR=

# ---------------------------------------------------------------------------
# 10. Fine-tuning (the code's default works; only change it if you know the effect)
# ---------------------------------------------------------------------------

# Conversation memory and compaction (in tokens).
# COMPACT_HIGH=24000
# COMPACT_LOW=12000
# SUMMARY_CAP=3000
# LEDGER_CAP=6000
# MEMORIA_BUSCA_V2=
# MEMORIA_HISTORICO=
# MEMORIA_RECONCILIAR=
# PERFIL_MODO=
# PERFIL_MAX_LINHAS=15
# PERFIL_DIFF_VERBOSE=

# Coding sub-agent.
# CODE_DEFER=1
# CODING_BLOB_MAX=
# CODING_COMPACT=
# CODING_COMPACT_TRIGGER=
# CODING_HISTORY_MAX=
# CODING_KEEP_RECENT=
# CODING_SESSION_TTL_MS=

# Conversation between assistants.
# A2A_BUDGET_TOKENS=40000
# A2A_MAX_ROUNDS=3
# A2A_NOTIFY_EMAIL=

# Credits.
# CREDIT_CHECKPOINT_RETENTION_DAYS=

# Other.
# List of plugins for this installation (file with `export default [plugin, ...]`),
# absolute path or relative to the folder the server runs from. Default: web/plugins/ativos.mjs.
# BRAMBIT_PLUGINS=
# CALENDAR_WATCH=1
# HOME_REFRESH_COOLDOWN_MS=86400000
# FREIO_FUNDAMENTACAO=1
# LIKENESS_AUTO_VERIFY=
# DISCOVERY_ENABLED=
# TURN_HEARTBEAT_MS=60000
